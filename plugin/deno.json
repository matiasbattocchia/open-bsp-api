{
  "exclude": [
    "dist/"
  ],
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "bundle": "npx -y deno@2.9.6 bundle --platform deno --minify --quiet -o dist/server.mjs server.ts"
  },
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-unversioned-import",
        "no-import-prefix"
      ]
    }
  },
  "imports": {
    "@modelcontextprotocol/sdk/server/index.js": "npm:@modelcontextprotocol/sdk@1.25.3/server/index.js",
    "@modelcontextprotocol/sdk/server/stdio.js": "npm:@modelcontextprotocol/sdk@1.25.3/server/stdio.js",
    "@modelcontextprotocol/sdk/types.js": "npm:@modelcontextprotocol/sdk@1.25.3/types.js",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.49.8"
  }
}
